# Thaw configuration. Copy to `.env` and fill in what you have.
# Every integration is optional: with no keys, Thaw runs in a complete local demo mode.
#
# IMPORTANT: Expo inlines every EXPO_PUBLIC_* variable into the app bundle.
# Anything here can be extracted from a shipped app. These are fine for a local
# hackathon demo; production keys must live behind a backend proxy (see README).

# Google Gemini (AI quest generation). Get one at https://aistudio.google.com/apikey
# Equivalent to GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
EXPO_PUBLIC_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# Perceptron (photo evidence verification). Chat-completions API at api.perceptron.inc.
# Equivalent to PERCEPTRON_API_KEY=YOUR_PERCEPTRON_API_KEY_HERE
EXPO_PUBLIC_PERCEPTRON_API_KEY=YOUR_PERCEPTRON_API_KEY_HERE
EXPO_PUBLIC_PERCEPTRON_BASE_URL=https://api.perceptron.inc/v1
EXPO_PUBLIC_PERCEPTRON_MODEL=perceptron-mk1.5

# Photon (party invites). Photon 2.0 is a messaging-agent platform (iMessage/SMS/etc.),
# which requires a server-side agent. The app does not call Photon directly; set the
# URL of your own invite-relay backend here if you build one (see README).
# Equivalent to PHOTON_API_KEY=YOUR_PHOTON_API_KEY_HERE (server-side only, never in the app)
EXPO_PUBLIC_PHOTON_RELAY_URL=

# OpenStreetMap Overpass endpoint for real nearby places (public, no key).
EXPO_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter
