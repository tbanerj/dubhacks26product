# Top-level Spectrum credentials (from your Photon dashboard).
# Stable Spectrum uses a project id and secret. A PHOTON_API_KEY is not a substitute.
PROJECT_ID=
PROJECT_SECRET=

# demo keeps messages on this machine. photon uses the iMessage route above.
# If unset, photon is chosen when PROJECT_ID is present.
THAW_TRANSPORT=demo
THAW_VERIFIER=demo
THAW_DATABASE_PATH=data/thaw.sqlite
THAW_MEDIA_DIR=data/media
PORT=3001

# Development-only app stand-in. Off for photon unless set to 1.
# Send header x-thaw-dev-user. This is not production authentication.
THAW_DEV_API=1

THAW_MAX_IMAGE_BYTES=10485760
THAW_MAX_IMAGE_PIXELS=20000000
THAW_MEDIA_RETENTION_HOURS=24
THAW_DEFAULT_TIMEZONE=America/Los_Angeles

# Live verification is intentionally unsupported until a real API contract is added.
# GEMINI_API_KEY is unused. Quest text comes from local templates.
