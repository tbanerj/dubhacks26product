# Top-level Spectrum credentials (from your Photon dashboard).
# Stable Spectrum uses a project id and secret. A PHOTON_API_KEY is not a substitute.
PROJECT_ID=
PROJECT_SECRET=

# demo keeps messages on this machine. photon uses the iMessage route above.
# If unset, photon is chosen when PROJECT_ID is present.
THAW_TRANSPORT=demo
THAW_VERIFIER=demo
THAW_DATABASE_PATH=data/thaw.sqlite
THAW_MEDIA_DIR=data/media
PORT=3001

# Development-only app stand-in. Off for photon unless set to 1.
# Send header x-thaw-dev-user. This is not production authentication.
THAW_DEV_API=1

# PING replies only when this is 1. It does not award XP.
THAW_DIAGNOSTICS=1

# 0 turns the whole text loop off. Proactive prompts stay off unless set to 1.
MESSAGING_ENABLED=1
MESSAGING_PROACTIVE_ENABLED=0

# Bind address for the app API. 127.0.0.1 is the default. Use a LAN address for a phone.
THAW_API_HOST=127.0.0.1

# Exact browser origins allowed to POST /api/public/signup, comma-separated.
# Unset allows only http://localhost:5173 and http://127.0.0.1:5173.
# Setting this replaces those defaults, so keep the local origins in the list.
# THAW_SIGNUP_ALLOWED_ORIGINS=https://dubhacks26product.vercel.app,http://localhost:5173,http://127.0.0.1:5173

THAW_MAX_IMAGE_BYTES=10485760
THAW_MAX_IMAGE_PIXELS=20000000
THAW_MEDIA_RETENTION_HOURS=24
THAW_DEFAULT_TIMEZONE=America/Los_Angeles

# Server-only. Live photo checks use this key. Never put it in the Expo app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server-only. Used to verify the app session and to copy linked rewards.
# SUPABASE_PUBLISHABLE_KEY must match thaw/.env.example (sb_publishable_…).
# SUPABASE_SERVICE_ROLE_KEY must never be EXPO_PUBLIC_.
SUPABASE_URL=https://rxtllandrfntemhiyzun.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_peS9Vt0CKnwqOrmYho1DWQ_FGv6tXTD
SUPABASE_SERVICE_ROLE_KEY=
