# Thaw configuration. Copy to `.env`.
#
# Expo inlines every EXPO_PUBLIC_* variable into the app bundle, so ONLY public values
# belong here. Secrets (Gemini key, Supabase secret key) live in Supabase, never in the app.

# Supabase (accounts, cloud saves, global leaderboards).
# The publishable key is designed to ship in apps: Row Level Security protects the data.
# NEVER put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://rxtllandrfntemhiyzun.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_peS9Vt0CKnwqOrmYho1DWQ_FGv6tXTD

# Google Gemini (AI quests + photo verification) runs SERVER-SIDE in Supabase Edge Functions.
# Its key is NOT set here. Set it once as an Edge Function secret (see README):
#   Supabase Dashboard -> Edge Functions -> Secrets -> GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Photon (party invites). Photon 2.0 is a messaging-agent platform (iMessage/SMS/etc.),
# which requires a server-side agent. The app does not call Photon directly; set the
# URL of your own invite-relay backend here if you build one (see README).
# Equivalent to PHOTON_API_KEY=YOUR_PHOTON_API_KEY_HERE (server-side only, never in the app)
EXPO_PUBLIC_PHOTON_RELAY_URL=

# OpenStreetMap Overpass endpoint for real nearby places (public, no key).
# Thaw automatically falls back to public mirrors if this one is busy.
EXPO_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter
